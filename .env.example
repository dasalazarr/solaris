# Copia a .env (no se versiona). Datos del demo 100% sintéticos (ADR-0004).
# LLM vía OpenRouter (ADR-0003). Necesaria a partir de M2-T6.
OPENROUTER_API_KEY=
# Postgres local (docker-compose)
POSTGRES_PASSWORD=
SOLARIS_DB_PORT=5433
# Sustituye <POSTGRES_PASSWORD> por el valor real (no se interpola)
DATABASE_URL=postgresql://solaris:<POSTGRES_PASSWORD>@127.0.0.1:5433/solaris
