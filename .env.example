# Copia a .env (no se versiona). Datos del demo 100% sintéticos (ADR-0004).
# LLM vía OpenRouter (ADR-0003). Necesaria a partir de M2-T6.
OPENROUTER_API_KEY=
# Postgres local (docker-compose)
POSTGRES_PASSWORD=
SOLARIS_DB_PORT=5433
# Sustituye <POSTGRES_PASSWORD> por el valor real (no se interpola)
DATABASE_URL=postgresql://solaris:<POSTGRES_PASSWORD>@127.0.0.1:5433/solaris
# Rol de BD de solo lectura del MCP erp-mock (M3-T1). Lo crea la migración 002; `solaris.db.migrate`
# fija su contraseña desde aquí. Genera un valor aleatorio (p. ej. `openssl rand -hex 24`).
ERP_READER_PASSWORD=
# Audit log de solo anexar (M4-T2, F08). Roles creados por la migración 003; `solaris.db.migrate`
# fija sus contraseñas desde aquí. Genera valores aleatorios (p. ej. `openssl rand -hex 24`).
AUDIT_WRITER_PASSWORD=
AUDIT_READER_PASSWORD=
# Prompts en el audit: truncate (sha256 + extracto sin secretos) | hash (solo sha256). Piloto: hash.
AUDIT_PROMPT_MODE=truncate
# true = si el audit falla, la operación falla (fail-closed). Obligatorio antes de un piloto.
AUDIT_REQUIRED=false
