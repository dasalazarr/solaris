# Copia a .env (no se versiona). Datos del demo 100% sintéticos (ADR-0004).
# LLM vía OpenRouter (ADR-0003). Necesaria a partir de M2-T6.
OPENROUTER_API_KEY=
# Postgres local (docker-compose)
POSTGRES_PASSWORD=
SOLARIS_DB_PORT=5433
# Opcional (rol ADMINISTRATIVO: migraciones, ingesta, sync de ACL). Si la descomentas, sustituye
# <POSTGRES_PASSWORD> por el valor real (no se interpola). Sin ella se usan las piezas de arriba.
# DATABASE_URL=postgresql://solaris:<POSTGRES_PASSWORD>@127.0.0.1:5433/solaris
# Rol de BD de la API en runtime (M4-T1): solo EXECUTE sobre rag.visible_*, sin SELECT directo sobre
# rag.* ni acceso a erp/audit. Lo crea la migración 006; `solaris.db.migrate` fija su contraseña.
SOLARIS_APP_PASSWORD=
# Rol de BD de solo lectura del MCP erp-mock (M3-T1). Lo crea la migración 002; `solaris.db.migrate`
# fija su contraseña desde aquí. Genera un valor aleatorio (p. ej. `openssl rand -hex 24`).
ERP_READER_PASSWORD=
# Audit log de solo anexar (M4-T2, F08). Roles creados por la migración 003; `solaris.db.migrate`
# fija sus contraseñas desde aquí. Genera valores aleatorios (p. ej. `openssl rand -hex 24`).
AUDIT_WRITER_PASSWORD=
AUDIT_READER_PASSWORD=
# Prompts en el audit: truncate (sha256 + extracto sin secretos) | hash (solo sha256). Piloto: hash.
AUDIT_PROMPT_MODE=truncate
# true = si el audit falla, la operación falla (fail-closed). Obligatorio antes de un piloto.
AUDIT_REQUIRED=false
# Embeddings locales (M2-T3). fastembed = intfloat/multilingual-e5-large ONNX (1024 dims, ~2,2 GB,
# se descarga una vez con revisión fijada); fake = determinista, sin descarga (tests). No usan OpenRouter.
EMBED_BACKEND=fastembed
# EMBED_MODEL_DIR=/ruta/absoluta/multilingual-e5-large-onnx   (por defecto ~/.cache/solaris/models/...)
# Rerank local (M2-T5). fastembed = BAAI/bge-reranker-base ONNX (~1,1 GB, MIT, revisión fijada);
# fake = solapamiento de tokens (tests); none = sin rerank (solo fusión RRF).
RERANK_BACKEND=fastembed
# RERANK_MODEL_DIR=/ruta/absoluta/bge-reranker-base   (por defecto ~/.cache/solaris/models/...)
# Autenticación del demo (M4-T1, F09; ADR-0002). JWT HS256: secreto aleatorio de ≥32 caracteres
# (p. ej. `openssl rand -hex 32`). Sin él, /auth/login responde 503 (falla cerrado).
AUTH_JWT_SECRET=
# Vida máxima del token/sesión y cierre por inactividad (segundos). E1-US4: dispositivos compartidos.
AUTH_TOKEN_TTL_S=1800
AUTH_IDLE_TIMEOUT_S=900
# Contraseñas de demo de los usuarios de acl.json (≥16 caracteres, aleatorias; vacía = sin acceso).
DEMO_PASSWORD_INAKI_CALIDAD=
DEMO_PASSWORD_ANDER_TURNO=
DEMO_PASSWORD_AUDITORA_EXT=
DEMO_PASSWORD_JON_IT=
